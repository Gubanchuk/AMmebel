# Копия этого файла с реальными значениями лежит на сервере:
# /opt/am-site/infra/.env (chmod 600, владелец deploy). В гит не попадает.

DB_NAME=am_site
DB_USER=am_site
DB_PASSWORD=

# Ключ подписи сессий Directus. Генерируется один раз: openssl rand -hex 32
# Смена ключа разлогинивает всех и ломает уже выданные токены.
DIRECTUS_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Адрес, по которому админка открывается снаружи. До подключения домена
# оставить пустым — Directus соберёт ссылки по запросу.
PUBLIC_URL=

# Статический токен служебного пользователя «Сборка сайта»: читает контент,
# в заявки не имеет доступа. Им фронт забирает данные на этапе сборки.
FRONTEND_TOKEN=
