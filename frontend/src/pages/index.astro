---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Conditions from '../components/Conditions.astro';
import Showcase from '../components/Showcase.astro';
import Needs from '../components/Needs.astro';
import Production from '../components/Production.astro';
import PriceForm from '../components/PriceForm.astro';
import Footer from '../components/Footer.astro';
import CookieBar from '../components/CookieBar.astro';
import { getContent } from '../lib/content';

const { settings, conditions, models } = getContent();
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Фабрика мягкой мебели в Краснодаре. Минимальный заказ — от 1 изделия, срок производства 25–30 рабочих дней." />
		<title>Авторская Мебель — мягкая мебель оптом от фабрики</title>
		<link rel="canonical" href="https://am-fabrika.ru/" />
		<meta name="theme-color" content="#131210" />
		<!-- Link previews in messengers (MAX, WhatsApp, Telegram) and social networks. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Авторская Мебель" />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content="https://am-fabrika.ru/" />
		<meta property="og:title" content="Авторская Мебель — мягкая мебель оптом от фабрики" />
		<meta property="og:description" content="Фабрика мягкой мебели в Краснодаре. Минимальный заказ — от 1 изделия, срок производства 25–30 рабочих дней." />
		<meta property="og:image" content="https://am-fabrika.ru/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Header settings={settings} />
		<main>
			<Hero settings={settings} models={models} />
			<Conditions conditions={conditions} />
			<Showcase settings={settings} models={models} />
			<Needs />
			<Production />
			<PriceForm />
		</main>
		<Footer settings={settings} />
		<CookieBar />
	</body>
</html>
