---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Conditions from '../components/Conditions.astro';
import Showcase from '../components/Showcase.astro';
import Needs from '../components/Needs.astro';
import Production from '../components/Production.astro';
import PriceForm from '../components/PriceForm.astro';
import Footer from '../components/Footer.astro';
import CookieBar from '../components/CookieBar.astro';
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Фабрика мягкой мебели в Краснодаре. Минимальный заказ — от 1 изделия, срок производства 25–30 рабочих дней." />
		<title>Авторская Мебель — мягкая мебель оптом от фабрики</title>
	</head>
	<body>
		<Header />
		<main>
			<Hero />
			<Conditions />
			<Showcase />
			<Needs />
			<Production />
			<PriceForm />
		</main>
		<Footer />
		<CookieBar />
	</body>
</html>
