---
// Legal page skeleton (task 7, block 11). Section headings follow the §6.1
// checklist in clients/sf-sofa/research/opt-site-stack-2026-08/raw/04-fz152.md
// (item 1: policy content required per ст. 18.1 for each processing purpose;
// items 7-10: cookies, Yandex as processor-by-assignment, operator details,
// revocation method). No legal text is invented here — the client's legal
// package supplies the actual wording; publication is gated by task 17.
import '../styles/tokens.css';
import '../styles/base.css';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import CookieBar from '../components/CookieBar.astro';

const sections = [
	'Оператор персональных данных',
	'Цели обработки персональных данных',
	'Категории и перечень обрабатываемых персональных данных',
	'Категории субъектов персональных данных',
	'Способы обработки персональных данных',
	'Сроки обработки и хранения персональных данных',
	'Порядок уничтожения персональных данных',
	'Меры по обеспечению безопасности персональных данных',
	'Передача персональных данных третьим лицам (обработка по поручению — Яндекс.Метрика)',
	'Файлы cookie',
	'Права субъекта персональных данных и порядок отзыва согласия',
	'Контакты для обращений по вопросам обработки персональных данных',
];
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<!-- Controller ruling R16: skeleton ships before task 17 inserts the real legal
		     text — must not be indexable until then. Task 17 removes this tag. -->
		<meta name="robots" content="noindex" />
		<title>Политика обработки персональных данных — АМ</title>
	</head>
	<body>
		<header class="top">
			<div class="wrap">
				<a href="/" aria-label="На главную"><Logo size="sm" /></a>
			</div>
		</header>

		<section class="sec legal">
			<div class="wrap">
				<h1>Политика в отношении обработки персональных данных</h1>
				<p class="legal__note">Текст предоставляется юридическим пакетом клиента; страница не публикуется до вставки текста.</p>
				<ol class="legal__toc">
					{sections.map((s) => (
						<li>{s}</li>
					))}
				</ol>
			</div>
		</section>

		<Footer />
		<CookieBar />
	</body>
</html>

<style>
	.top { border-bottom: 1px solid var(--line-soft); }
	.top .wrap { display: flex; align-items: center; padding-top: 20px; padding-bottom: 20px; }

	.legal h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(24px, 3.8vw, 34px); line-height: 1.15; margin: 0 0 18px; color: var(--ivory); max-width: 32ch; }
	.legal__note { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--grey-dim); border: 1px solid var(--line); padding: 14px 16px; margin: 0 0 32px; max-width: 60ch; }
	.legal__toc { margin: 0; padding: 0; list-style: none; counter-reset: sec; }
	.legal__toc li { counter-increment: sec; display: flex; gap: 16px; border-top: 1px solid var(--line-soft); padding: 14px 0; color: var(--grey); font-size: 14.5px; }
	.legal__toc li:last-child { border-bottom: 1px solid var(--line-soft); }
	.legal__toc li:before { content: counter(sec, decimal-leading-zero); flex: 0 0 24px; font-family: var(--mono); font-size: 11px; color: var(--grey-dim); }
</style>
