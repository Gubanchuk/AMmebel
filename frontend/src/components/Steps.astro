---
// Steps (page block 09). Timing/payment numbers are the client's confirmed
// answers (срок производства, предоплата), not the original placeholder.
const steps = [
	{ n: '01', title: 'Заявка', body: 'Оставляете заявку или проходите квиз — отвечаем в течение рабочего дня.' },
	{ n: '02', title: 'Договор и предоплата', body: 'Подписываем договор поставки, вносите предоплату 50%.' },
	{ n: '03', title: 'Производство', body: '25–30 рабочих дней, максимум 40.' },
	{ n: '04', title: 'Доплата и отгрузка', body: 'Доплата по факту готовности, затем отгрузка транспортной компанией.' },
];
---

<section class="sec steps" id="steps">
	<div class="wrap">
		<h2>Как начать</h2>
		<p class="sec__lead">Сроки фиксируем в договоре поставки.</p>
		<ol class="steps__list">
			{steps.map((s) => (
				<li>
					<span class="steps__n lbl">{s.n}</span>
					<h3>{s.title}</h3>
					<p>{s.body}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.steps__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 26px; counter-reset: none; }
	.steps__list li { border-top: 1px solid var(--line-soft); padding-top: 16px; }
	.steps__n { display: block; margin: 0 0 10px; }
	.steps__list h3 { font-size: 16px; font-weight: 600; color: var(--ivory); margin: 0 0 8px; }
	.steps__list p { color: var(--grey); font-size: 14px; line-height: 1.5; margin: 0; }
</style>
