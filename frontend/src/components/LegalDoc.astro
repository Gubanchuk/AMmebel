---
// Legal document page, shared by /politika, /soglasie and /soglasie-cookie.
// The text is src/legal/*.md, generated by scripts/sync-legal.mjs from the
// client's legal package (clients/sf-sofa/legal/), which the server build does
// not have — the generated files are committed.
//
// Publication guard: a text that still contains "[[" (an unfilled placeholder
// such as [[номер приказа]]) is never rendered. The page shows a one-line
// "being prepared" note, stays noindex, and the build prints a warning.
// LEGAL_PREVIEW=1 renders the full text anyway, for local review only.
//
// Tables are wrapped in their own horizontal scroll box, so a wide table never
// scrolls the page at 390px.
import '../styles/tokens.css';
import '../styles/base.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CookieBar from './CookieBar.astro';
import { getContent } from '../lib/content';

interface LegalMarkdown {
	frontmatter: { title?: string; source?: string };
	rawContent(): string;
	compiledContent(): string | Promise<string>;
}

interface Props {
	/** H1 and <title>, per clients/sf-sofa/legal/07-teksty-dlya-sajta.md §4. */
	title: string;
	/** Canonical path with the trailing slash the server redirects to, e.g. "/politika/". */
	path: string;
	doc: LegalMarkdown;
}

const { title, path, doc } = Astro.props;
const { settings } = getContent();

const docTitle = doc.frontmatter.title ?? '';
const hasPlaceholders = `${docTitle}\n${doc.rawContent()}`.includes('[[');
const preview = process.env.LEGAL_PREVIEW === '1';
const published = !hasPlaceholders || preview;

if (hasPlaceholders) {
	console.warn(
		preview
			? `[legal] ${path}: LEGAL_PREVIEW=1 renders a text with [[placeholders]]. Do not deploy this build.`
			: `[legal] ${path}: text contains [[placeholders]], the page shows "document is being prepared". Fill them in clients/sf-sofa/legal/${doc.frontmatter.source ?? ''}, run node scripts/sync-legal.mjs and rebuild.`,
	);
}

let html = '';
if (published) {
	html = (await doc.compiledContent()).replace(/<table\b[^>]*>[\s\S]*?<\/table>/g, (table) => {
		const head = table.match(/<thead\b[\s\S]*?<\/thead>/);
		const cols = head ? (head[0].match(/<th[\s>]/g) ?? []).length : 2;
		return `<div class="legal__scroll" style="--cols:${cols}" role="region" aria-label="Таблица" tabindex="0">${table}</div>`;
	});
}

// The policy's full official name differs from the short page H1 — show it under the H1.
const subtitle = docTitle && docTitle !== title ? docTitle : null;
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#131210" />
		{published ? (
			<link rel="canonical" href={`https://am-fabrika.ru${path}`} />
		) : (
			<meta name="robots" content="noindex" />
		)}
		<title>{title}</title>
	</head>
	<body>
		<Header settings={settings} />

		<main>
			<article class:list={['sec', 'legal', { 'legal--pending': !published }]}>
				<div class="wrap">
					<h1>{title}</h1>
					{published ? (
						<Fragment>
							{subtitle && <p class="legal__doc">{subtitle}</p>}
							<div class="legal__body" set:html={html} />
						</Fragment>
					) : (
						<p class="legal__note">Документ готовится к публикации.</p>
					)}
				</div>
			</article>
		</main>

		<Footer settings={settings} />
		<CookieBar />
	</body>
</html>

<style>
	.legal h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(24px, 3.8vw, 34px); line-height: 1.15; margin: 0 0 18px; color: var(--ivory); max-width: 32ch; text-wrap: balance; }
	.legal__note { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--grey-dim); border: 1px solid var(--line); padding: 14px 16px; margin: 0; max-width: 60ch; }
	.legal--pending { min-height: 45vh; }
	.legal__doc { color: var(--grey); font-size: 15.5px; margin: 0 0 40px; max-width: 72ch; text-wrap: balance; }

	.legal__body { color: var(--grey); font-size: 15.5px; line-height: 1.7; overflow-wrap: break-word; padding-top: 4px; }
	.legal__body > :global(:first-child) { margin-top: 0; }

	.legal__body :global(h2) {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(20px, 2.6vw, 25px);
		line-height: 1.25;
		color: var(--ivory);
		text-wrap: balance;
		/* base.css caps .sec h2 at 26ch; lift it so the section rule spans the same width as the tables */
		max-width: none;
		margin: 56px 0 20px;
		padding-top: 26px;
		border-top: 1px solid var(--line-soft);
	}
	/* the source separates the appendix with a rule; the h2 line already does that */
	.legal__body :global(hr) { border: 0; margin: 0; }
	.legal__body :global(hr + h2) { margin-top: 88px; border-top-color: var(--line); }

	.legal__body :global(p),
	.legal__body :global(ul),
	.legal__body :global(ol) { max-width: 72ch; margin: 0 0 14px; }
	.legal__body :global(strong) { color: var(--ivory); font-weight: 500; }
	.legal__body :global(a) { color: var(--ivory); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
	.legal__body :global(a:hover) { text-decoration-color: var(--grey-dim); }

	.legal__body :global(ul),
	.legal__body :global(ol) { padding-left: 22px; }
	.legal__body :global(li) { margin: 0 0 6px; padding-left: 4px; }
	.legal__body :global(li)::marker { color: var(--grey-dim); }
	.legal__body :global(p + ul),
	.legal__body :global(p + ol) { margin-top: -6px; }

	.legal__body :global(code) { font-family: var(--mono); font-size: .86em; color: var(--ivory); background: var(--panel); border: 1px solid var(--line); padding: 1px 5px; }

	/* request form in the policy appendix: GFM task list */
	.legal__body :global(ul:has(> li > input[type="checkbox"])) { list-style: none; padding-left: 0; }
	.legal__body :global(li:has(> input[type="checkbox"])) { padding-left: 0; }
	.legal__body :global(input[type="checkbox"]) {
		appearance: none;
		-webkit-appearance: none;
		width: 14px;
		height: 14px;
		margin: 0 10px 0 0;
		border: 1px solid var(--line-ui);
		background: transparent;
		vertical-align: -2px;
	}

	.legal__body :global(.legal__scroll) { overflow-x: auto; margin: 6px 0 24px; border: 1px solid var(--line); }
	.legal__body :global(.legal__scroll:focus-visible) { outline-offset: 2px; }
	.legal__body :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.55; }
	.legal__body :global(th),
	.legal__body :global(td) { text-align: left; vertical-align: top; padding: 12px 14px; border-bottom: 1px solid var(--line); }
	.legal__body :global(th + th),
	.legal__body :global(td + td) { border-left: 1px solid var(--line-soft); }
	.legal__body :global(tbody tr:last-child td) { border-bottom: 0; }
	.legal__body :global(th) { font-family: var(--mono); font-weight: 400; font-size: 10.5px; letter-spacing: .11em; text-transform: uppercase; color: var(--grey-dim); background: var(--panel); white-space: nowrap; }

	@media (max-width: 740px) {
		/* below this width tables keep a readable column width and scroll inside their box */
		.legal__body :global(table) { min-width: calc((var(--cols, 2) - 1) * 13rem); }
	}
	@media (max-width: 620px) {
		.legal__body { font-size: 15px; line-height: 1.65; }
		.legal__doc { font-size: 15px; margin-bottom: 32px; }
		.legal__body :global(h2) { margin-top: 44px; padding-top: 22px; }
		.legal__body :global(hr + h2) { margin-top: 64px; }
		.legal__body :global(table) { font-size: 13.5px; }
		.legal__body :global(th),
		.legal__body :global(td) { padding: 10px 12px; }
	}
</style>
