---
// Conditions table (page block 02) — imports content-fallback.json directly per
// Ruling R4 (task 10 will switch this to props sourced from Directus).
import content from '../../../content-fallback.json';

const { conditions } = content;
---

<section class="sec cond" id="conditions">
	<div class="wrap">
		<h2>Условия сотрудничества</h2>
		<div class="cond__scroll">
			<table class="cond__table">
				<tbody>
					{conditions.map((row: { name: string; value: string }) => (
						<tr>
							<th>{row.name}</th>
							<td>{row.value}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<p class="cond__note">Условия фиксируем в договоре поставки.</p>
	</div>
</section>

<style>
	.cond__scroll { overflow-x: auto; border-top: 1px solid var(--line-soft); }
	.cond__table { width: 100%; border-collapse: collapse; min-width: 480px; }
	.cond__table tr { border-bottom: 1px solid var(--line-soft); }
	/* Row labels are the scannable part of this table (user 08.09: «заголовки
	   крупнее и заметнее») — sans semibold in ivory, one size above the value;
	   values sit a shade lower so the label reads first. */
	.cond__table th { text-align: left; vertical-align: top; padding: 18px 28px 18px 0; white-space: nowrap; font-family: var(--sans); font-size: 16.5px; font-weight: 600; line-height: 1.35; color: var(--ivory); }
	.cond__table td { text-align: left; color: #DAD5C9; font-size: 15px; line-height: 1.55; padding: 18px 0; }
	.cond__note { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--grey-dim); margin: 18px 0 0; text-transform: uppercase; }

	/* Values here are full sentences (real client answers), not short data
	   points — a side-scrolling table reads badly for prose, so below 600px
	   the rows stack label-over-value instead of scrolling horizontally. */
	@media (max-width: 600px) {
		.cond__table { min-width: 0; width: 100%; }
		.cond__table tr { display: block; padding: 14px 0; }
		.cond__table th { display: block; padding: 0 0 6px; white-space: normal; font-size: 17px; }
		.cond__table td { display: block; padding: 0; }
	}
</style>
