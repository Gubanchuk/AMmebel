---
// Site header (page-wide) — extracted from the .top bar that used to live
// inline in Hero.astro, and now replaces the ad-hoc top bars politika.astro
// and soglasie.astro each had of their own. Mounted on all three pages;
// sticky at the top of the viewport (z-index 50, between the fixed CookieBar
// at 40 and the Showcase lightbox overlay at 100). The logo always links
// home — on index that's a scroll to top, on the legal pages a real
// navigation.
//
// Nav style is variant A ("caps text") from the picker at
// clients/sf-sofa/opt-site-mockups/header-variants.html, picked by the user
// after the first nav (dash-prefixed .ray links + a raw phone number next to
// the CTA) was rejected as looking off. Nav links are plain uppercase
// micro-labels with no decoration at rest — the underline grows in on
// hover/focus via a transform, never a layout-affecting property. The phone
// number has no home in the compact header bar in this variant.
//
// Mobile (≤700px; raised from 620 on 09.09 — the plate overflowed the row at 621–687px) drops the inline nav to keep one row with no wrap at
// 390px, but the user browsing the live deploy on a phone had no way to
// reach any section — this adds a "МЕНЮ" toggle that opens a fullscreen
// overlay with the same section links at a large caps size, plus the phone
// (absent from the compact bar) and a full-size price CTA. The overlay
// reuses Showcase's lightbox open/close/scroll-lock pattern verbatim
// (proven: hidden attribute + .on class + forced layout flush before the
// opacity transition, TRANSITION_MS matching --t).
import Logo from './Logo.astro';
import content from '../../../content-fallback.json';

const { settings } = content;
const telHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
---

<header class="hdr" id="siteHeader">
	<div class="wrap hdr__row">
		<a class="hdr__logo" href="/" aria-label="Авторская Мебель — на главную">
			<Logo size="sm" />
		</a>
		<nav class="hdr__nav" aria-label="Разделы страницы">
			<a href="/#models">Модели</a>
			<a href="/#conditions">Условия</a>
			<a href="/#production">Производство</a>
		</nav>
		<div class="hdr__right">
			<button
				type="button"
				class="hdr__menu-toggle"
				id="hdrMenuToggle"
				aria-expanded="false"
				aria-controls="hdrMenu"
			>Меню</button>
			<a class="cta hdr__price" href="/#price">
				<span class="hdr__price-full">Получить прайс</span>
				<span class="hdr__price-short">Прайс</span>
			</a>
		</div>
	</div>
</header>

<div class="hdr-menu" id="hdrMenu" role="dialog" aria-modal="true" aria-label="Меню" hidden>
	<div class="hdr-menu__top wrap">
		<button type="button" class="hdr-menu__close" id="hdrMenuClose">Закрыть</button>
	</div>
	<nav class="hdr-menu__nav wrap" aria-label="Разделы страницы">
		<a href="/#models">Модели</a>
		<a href="/#conditions">Условия</a>
		<a href="/#production">Производство</a>
	</nav>
	<div class="hdr-menu__foot wrap">
		<a class="hdr-menu__tel" href={telHref} id="hdrMenuTel">{settings.phone}</a>
		<a class="cta hdr-menu__price" href="/#price">Получить прайс</a>
	</div>
</div>

<style>
	.hdr {
		position: sticky;
		top: 0;
		z-index: 50;
		height: 72px;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.hdr__row { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 100%; }
	.hdr__logo { display: flex; align-items: center; flex: 0 0 auto; --logo-sm: 50px; }

	.hdr__nav { display: flex; align-items: center; gap: 34px; flex: 1 1 auto; justify-content: center; }
	.hdr__nav a {
		position: relative;
		display: inline-block;
		padding-bottom: 7px;
		font-family: var(--sans);
		font-size: 11px;
		letter-spacing: .1em;
		text-transform: uppercase;
		color: var(--grey);
		text-decoration: none;
		transition: color var(--t) ease;
	}
	.hdr__nav a:after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: var(--ivory);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--t) ease;
	}
	.hdr__nav a:hover,
	.hdr__nav a:focus-visible { color: var(--ivory); }
	.hdr__nav a:hover:after,
	.hdr__nav a:focus-visible:after { transform: scaleX(1); }

	.hdr__right { display: flex; align-items: center; gap: 20px; flex: 0 0 auto; }

	/* Hidden on desktop — the inline .hdr__nav covers navigation there. */
	.hdr__menu-toggle {
		display: none;
		background: none;
		border: 0;
		padding: 14px 10px; /* ≥40px tap target; margin pulls the box back so layout is unchanged */
		margin: -14px -10px;
		cursor: pointer;
		font-family: var(--sans);
		font-size: 11px;
		letter-spacing: .1em;
		text-transform: uppercase;
		color: var(--grey);
		transition: color var(--t) ease;
	}
	.hdr__menu-toggle:hover,
	.hdr__menu-toggle:focus-visible { color: var(--ivory); }

	/* .hdr__price reuses the shared .cta class for fill/border/hover-invert/
	   flash/transition/focus — only layout and sizing are overridden here so
	   the header's compact plate can't silently drift from the button system.
	   .cta's own default is 18px/38px padding at 12px font, sized for the
	   hero/PriceForm CTA; the header needs a smaller instance to fit its
	   60px bar. .cta's :after light-line flash is left untouched — it reads
	   fine at this scale. */
	.hdr__price { flex: 0 0 auto; padding: 12px 26px; font-size: 11px; }
	.hdr__price-short { display: none; }

	@media (max-width: 700px) {
		.hdr { height: 64px; }
		.hdr__logo { --logo-sm: 42px; }
		.hdr__nav { display: none; }
		.hdr__menu-toggle { display: inline-block; }
		/* .cta's own ≤470px rule sets width:100% for the full-size hero button
		   — reset it here so the compact plate doesn't stretch across the row. */
		.hdr__price { width: auto; padding: 10px 18px; }
		.hdr__price-full { display: none; }
		.hdr__price-short { display: inline; }
	}

	/* .hdr__price's own transitions come from .cta, which already has a
	   prefers-reduced-motion rule in base.css — only the nav underline and
	   the menu toggle/overlay (local to this component) need one here. */
	@media (prefers-reduced-motion: reduce) {
		.hdr__nav a,
		.hdr__nav a:after,
		.hdr__menu-toggle,
		.hdr-menu,
		.hdr-menu__nav a:after,
		.hdr-menu__close,
		.hdr-menu__tel { transition: none; }
	}

	/* ============ fullscreen mobile menu overlay ============ */
	.hdr-menu {
		position: fixed;
		inset: 0;
		z-index: 60;
		background: var(--bg);
		display: flex;
		flex-direction: column;
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--t) ease;
		overflow-y: auto;
	}
	/* the UA's [hidden]{display:none} loses to the display:flex above — restate it,
	   otherwise the closed overlay stays in the tab order (six invisible stops) */
	.hdr-menu[hidden] { display: none; }
	.hdr-menu.on { opacity: 1; pointer-events: auto; }

	.hdr-menu__top { display: flex; justify-content: flex-end; align-items: center; height: 64px; flex: 0 0 auto; border-bottom: 1px solid var(--line); }
	.hdr-menu__close {
		background: none;
		border: 0;
		padding: 14px 10px;
		margin: -14px -10px;
		cursor: pointer;
		font-family: var(--sans);
		font-size: 11px;
		letter-spacing: .1em;
		text-transform: uppercase;
		color: var(--grey);
		transition: color var(--t) ease;
	}
	.hdr-menu__close:hover,
	.hdr-menu__close:focus-visible { color: var(--ivory); }

	.hdr-menu__nav { display: flex; flex-direction: column; padding-top: 8px; }
	.hdr-menu__nav a {
		position: relative;
		display: block;
		padding: 20px 0;
		font-family: var(--sans);
		font-weight: 500;
		font-size: clamp(22px, 6vw, 26px);
		letter-spacing: .02em;
		text-transform: uppercase;
		color: var(--ivory);
		text-decoration: none;
		border-top: 1px solid var(--line-soft);
	}
	.hdr-menu__nav a:last-child { border-bottom: 1px solid var(--line-soft); }
	.hdr-menu__nav a:after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 2px;
		background: var(--ivory);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--t) ease;
	}
	.hdr-menu__nav a:hover:after,
	.hdr-menu__nav a:focus-visible:after { transform: scaleX(1); }

	.hdr-menu__foot { display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 32px 0 40px; margin-top: auto; }
	.hdr-menu__tel {
		font-family: var(--mono);
		font-size: 15px;
		color: var(--ivory);
		text-decoration: none;
		transition: color var(--t) ease, text-shadow var(--t) ease;
	}
	.hdr-menu__tel:hover { text-shadow: 0 0 12px var(--glow); }
	/* .cta already goes full-width at ≤470px (base.css) — this holds that
	   same intent across the whole ≤620px range the overlay lives in, since
	   a compact inline button would look stranded in a fullscreen menu. */
	.hdr-menu__price { width: 100%; }

	/* The toggle that opens this overlay only exists ≤620px, but pin this
	   too as a safety net in case the viewport is resized wider while open. */
	@media (min-width: 701px) {
		.hdr-menu { display: none !important; }
	}
	/* repeated here because the earlier reduced-motion block sits above the
	   .hdr-menu transition rule and loses to it in the cascade */
	@media (prefers-reduced-motion: reduce) {
		.hdr-menu { transition: none; }
	}
</style>

<script>
	// Mobile fullscreen menu — open/close/scroll-lock pattern copied verbatim
	// from ../scripts/lightbox.js (hidden attribute + .on class + forced
	// layout flush before the opacity transition, TRANSITION_MS matching --t).
	(function () {
		var toggle = document.getElementById('hdrMenuToggle');
		var overlay = document.getElementById('hdrMenu');
		var closeBtn = document.getElementById('hdrMenuClose');
		if (!toggle || !overlay || !closeBtn) return;

		var TRANSITION_MS = 450; // matches --t (.45s)
		var closeTimeoutId = null;

		function reducedMotion() {
			return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		}

		function open() {
			if (closeTimeoutId !== null) {
				window.clearTimeout(closeTimeoutId);
				closeTimeoutId = null;
			}
			overlay.hidden = false;
			document.body.style.overflow = 'hidden';
			// Force a layout flush so the browser commits the un-hidden state
			// before the opacity transition starts (same reasoning as the
			// lightbox — rAF-based deferral was unreliable right after load).
			void overlay.offsetHeight;
			overlay.classList.add('on');
			toggle.setAttribute('aria-expanded', 'true');
			closeBtn.focus();
		}

		// returnFocus is false for a link click inside the overlay — the user
		// is navigating away, so yanking focus back up to the (now often
		// off-screen) toggle would fight the browser's own fragment jump.
		function close(returnFocus) {
			if (overlay.hidden) return;
			// Re-entrancy guard, mirroring open()'s: without it, a second
			// close() call (e.g. a fast double-Esc) before the first
			// TRANSITION_MS timeout fires schedules a second timer without
			// clearing the first. The first still fires on schedule and nulls
			// the shared closeTimeoutId — losing the handle needed to cancel
			// the second — so if the overlay gets reopened in between, that
			// orphaned second timer later force-hides the freshly reopened one.
			if (closeTimeoutId !== null) {
				window.clearTimeout(closeTimeoutId);
				closeTimeoutId = null;
			}
			overlay.classList.remove('on');
			document.body.style.overflow = '';
			toggle.setAttribute('aria-expanded', 'false');
			var delay = reducedMotion() ? 0 : TRANSITION_MS;
			closeTimeoutId = window.setTimeout(function () {
				overlay.hidden = true;
				closeTimeoutId = null;
			}, delay);
			if (returnFocus !== false) { toggle.focus(); }
		}

		toggle.addEventListener('click', function () {
			if (overlay.hidden) { open(); } else { close(); }
		});
		closeBtn.addEventListener('click', function () { close(); });

		// Focus trap for the aria-modal dialog: the overlay's focusable set is
		// fixed (close button, 4 nav links, phone, price CTA — same order as
		// the markup), so a plain first/last wrap is enough — no need to walk
		// a dynamic list. Escape closes from anywhere while open.
		document.addEventListener('keydown', function (e) {
			if (overlay.hidden) return;
			if (e.key === 'Escape') { close(); return; }
			if (e.key !== 'Tab') return;
			var first = closeBtn;
			var last = overlay.querySelector('.hdr-menu__price');
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		// Clicking any link inside the overlay closes it without
		// preventDefault — the native fragment jump (scroll-margin-top on
		// .sec covers the header offset) proceeds underneath the fade-out.
		// The price link additionally has its own listener from consent.js
		// (attached to every a[href="#price"] in the DOM at load) that
		// handles the cookie-bar-aware scroll — both listeners fire, neither
		// interferes with the other.
		overlay.querySelectorAll('a').forEach(function (link) {
			link.addEventListener('click', function () {
				// close(false): don't return focus to the toggle here — the
				// user is navigating to a page section, so let the browser's
				// own focus/scroll flow take over instead of fighting it.
				close(false);
			});
		});

		// amGoal is defined once, globally, by quiz.js on the pages where the
		// quiz mounts. The legal pages don't load quiz.js, so guard the call
		// instead of assuming it exists — never redefine it here.
		var tel = document.getElementById('hdrMenuTel');
		if (tel) {
			tel.addEventListener('click', function () {
				if (typeof window.amGoal === 'function') { window.amGoal('phone_click'); }
			});
		}
	})();
</script>
