---
// Quiz stage — a real product photo with a CSS light-reveal per step, replacing
// the earlier SVG assembly scene (rejected by the user). Chosen photo:
// model-06.webp (charcoal bouclé loveseat) — of the 12 showcase photos, it has
// the strongest directional/raking side-light already baked into the shot
// (visible diagonal light-and-shadow bands across the cushions from a window,
// left of frame), the most readable upholstery texture under that light
// (bouclé's nubby weave catches contrast well), and the cleanest dark/neutral
// background (plain wall + two framed prints, no clutter) — the combination
// that reads most convincingly as "light gradually revealing form" once
// brightness/contrast are stepped up via CSS. Light state is driven by
// data-lit="1".."4" on .qz__scene, set by quiz.js's paint() (same place the
// old code toggled SVG opacity) — no new animation/JS framework, CSS
// transitions only. Behavior lives in ../scripts/quiz.js.
---

<div class="qz" id="qz">
	<div class="qz__stage">
		<div class="qz__scene" id="qzScene" data-lit="1">
			<img
				src="/models/model-06.webp"
				alt="Диван крупным планом — свет постепенно проявляет обивку"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
		<p class="qz__cap" id="qcap">Шаг 1 из 4 · включаем свет</p>
	</div>
	<div class="prg"><i class="on"></i><i></i><i></i><i></i></div>

	<div class="qz__body" id="qbody">
		<div class="step" data-s="1">
			<p class="qz__meta">Вопрос 1 из 4</p>
			<p class="qz__q">Что вы продаёте сейчас?</p>
			<button class="opt" type="button">Мебель в своём салоне или шоуруме</button>
			<button class="opt" type="button">Мебель на маркетплейсах или в интернет-магазине</button>
			<button class="opt" type="button">Комплектую объекты: отели, апарты, рестораны</button>
			<button class="opt" type="button">Я дизайнер или архитектор, привожу клиентов</button>
		</div>
		<div class="step" data-s="2" hidden>
			<p class="qz__meta">Вопрос 2 из 4</p>
			<p class="qz__q">Какой у вас масштаб?</p>
			<button class="opt" type="button">Одна точка или площадка</button>
			<button class="opt" type="button">От двух до пяти</button>
			<button class="opt" type="button">Больше пяти или сеть</button>
			<button class="opt" type="button">Только открываюсь</button>
		</div>
		<div class="step" data-s="3" hidden>
			<p class="qz__meta">Вопрос 3 из 4</p>
			<p class="qz__q">В каком городе работаете?</p>
			<div class="fld"><label for="q3">Город</label><input id="q3" placeholder="Ростов-на-Дону"></div>
		</div>
		<div class="step" data-s="4" hidden>
			<p class="qz__meta">Последний шаг</p>
			<p class="qz__q">Куда направить оптовое предложение?</p>
			<div class="fld"><label for="q4a">Имя</label><input id="q4a" placeholder="Как к вам обращаться"></div>
			<div class="fld"><label for="q4b">Телефон или мессенджер</label><input id="q4b" placeholder="+7 …"></div>
			<label class="qz__consent">
				<input type="checkbox" id="qzConsent">
				<span>Даю <a href="/soglasie">согласие на обработку персональных данных</a> и ознакомлен с <a href="/politika">политикой обработки персональных данных</a></span>
			</label>
			<p class="qz__err" id="qzError" role="alert" hidden></p>
		</div>
		<div class="qz__nav">
			<button class="ghost" type="button" id="qback" disabled>Назад</button>
			<button class="cta" type="button" id="qnext">Дальше</button>
		</div>
	</div>

	<div class="qz__res" id="qres">
		<h3>Свет включён</h3>
		<p>Заявка ушла менеджеру — он свяжется с вами и направит предложение под ваш запрос.</p>
	</div>
</div>

<style>
	.qz { background: var(--panel); border: 1px solid var(--line); position: relative; }
	.qz__stage { border-bottom: 1px solid var(--line); padding: 18px 20px 8px; background: linear-gradient(180deg,#161411,#1B1916); }
	.qz__scene { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #000; }
	.qz__scene img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 55%;
		display: block;
		filter: brightness(.3);
		transition: filter var(--t) ease;
	}
	.qz__scene:before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(70% 80% at 50% 10%, rgba(122,103,68,.35) 0%, rgba(72,60,40,.15) 45%, transparent 75%);
		opacity: .25;
		transition: opacity var(--t) ease;
	}
	.qz__scene[data-lit="2"] img { filter: brightness(.55); }
	.qz__scene[data-lit="2"]:before { opacity: .5; }
	.qz__scene[data-lit="3"] img { filter: brightness(.8); }
	.qz__scene[data-lit="3"]:before { opacity: .8; }
	.qz__scene[data-lit="4"] img { filter: brightness(1); }
	.qz__scene[data-lit="4"]:before { opacity: 1; }
	.qz__cap { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--grey-dim); text-align: center; padding: 8px 0 12px; margin: 0; }
	.qz__body { padding: 22px 20px 26px; }
	.qz__meta { font-family: var(--mono); font-size: 10px; letter-spacing: .11em; text-transform: uppercase; color: var(--grey-dim); margin: 0 0 10px; }
	.qz__q { font-weight: 600; font-size: clamp(17px,2.1vw,21px); margin: 0 0 16px; line-height: 1.25; color: var(--ivory); }
	.qz__nav { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 6px; }
	.qz__res { display: none; padding: 30px 20px 34px; text-align: center; }
	.qz__res.on { display: block; }
	.qz__res h3 { font-family: var(--serif); font-weight: 400; font-size: 22px; margin: 0 0 10px; color: var(--ivory); }
	.qz__res p { color: var(--grey); font-size: 14px; max-width: 40ch; margin: 0 auto; }

	.qz__consent { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; margin: 4px 0 14px; }
	.qz__consent input {
		appearance: none;
		-webkit-appearance: none;
		width: 18px;
		height: 18px;
		flex: 0 0 18px;
		border: 1px solid var(--line);
		background: transparent;
		margin-top: 2px;
		cursor: pointer;
		position: relative;
		transition: border-color var(--t) ease, background var(--t) ease;
	}
	.qz__consent input:checked { background: var(--ivory); border-color: var(--ivory); }
	.qz__consent input:checked:after {
		content: '';
		position: absolute;
		left: 5px;
		top: 1px;
		width: 5px;
		height: 9px;
		border: solid var(--bg);
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}
	.qz__consent span { color: var(--grey); font-size: 12.5px; line-height: 1.5; }
	.qz__consent a { color: var(--ivory); text-decoration: underline; text-underline-offset: 2px; }
	.qz__err { color: var(--ivory); font-size: 12px; margin: 0 0 10px; border-left: 2px solid var(--ivory); padding-left: 10px; }

	@media (max-width: 470px) {
		.qz__nav .cta { width: auto; flex: 1 1 auto; }
	}
	@media (prefers-reduced-motion: reduce) {
		.qz__consent input { transition: none; }
		.qz__scene img, .qz__scene:before { transition: none; }
	}
</style>

<script>
	import '../scripts/quiz.js';
</script>
