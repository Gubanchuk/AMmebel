---
// Footer (page block 12). settings from content-fallback.json (phone/email —
// the client's designated lead-handling contact, not the docx's registration
// phone). Legal requisites from the company-card docx — since 04.09 the footer
// is their only home (the Documents section was cut with the client's "shorter"
// feedback of 31.08). Factual address is settings.address (production), the
// registration address is legal.address. /politika and /soglasie: task 7.
import content from '../../../content-fallback.json';

const { settings } = content;
const legal = {
	name: 'ООО «Авторская мебель»',
	inn: '2373027390',
	kpp: '237301001',
	ogrn: '1252300034843',
	address: '353217, Краснодарский край, Динской район, с/п Южно-Кубанское, пос. Южный, ул. Войсковая, д. 1 Б, пом. 12',
};
const telHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const year = new Date().getFullYear();
---

<footer class="foot">
	<div class="wrap">
		<div class="foot__grid">
			<div>
				<p class="lbl">Юрлицо</p>
				<p>{legal.name}<br />ИНН {legal.inn} · КПП {legal.kpp}<br />ОГРН {legal.ogrn}</p>
				<p class="foot__sub">Юр. адрес: {legal.address}</p>
			</div>
			<div>
				<p class="lbl">Контакты</p>
				<p><a class="foot__tel" href={telHref} id="footTel">{settings.phone}</a></p>
				<p class="foot__sub">Основной мессенджер — MAX, также WhatsApp и Telegram</p>
				<p><a class="foot__mail" href={`mailto:${settings.email}`}>{settings.email}</a></p>
			</div>
			<div>
				<p class="lbl">Адрес</p>
				<p>{settings.address}</p>
			</div>
			<div>
				<p class="lbl">Документы</p>
				<p><a class="ray" href="/politika"><i></i>Политика персональных данных</a></p>
				<p><a class="ray" href="/soglasie"><i></i>Согласие на обработку данных</a></p>
			</div>
		</div>
		<p class="foot__legal">АВТОРСКАЯ МЕБЕЛЬ · ОПТ-САЙТ · {year}</p>
	</div>
</footer>

<style>
	.foot { border-top: 1px solid var(--line-soft); padding-top: 40px; padding-bottom: 32px; }
	.foot__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin-bottom: 30px; }
	@media (max-width: 990px) { .foot__grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 480px) { .foot__grid { grid-template-columns: 1fr; } }
	.foot__grid p { margin: 4px 0 0; color: var(--grey); font-size: 13.5px; line-height: 1.5; }
	.foot__grid .lbl { margin: 0; }
	.foot__grid a { text-decoration: none; }
	.foot__tel, .foot__mail { display: inline-block; padding: 11px 0; margin: -11px 0; } /* ≥40px tap target, layout unchanged */
	.foot__tel { font-family: var(--mono); color: var(--ivory); transition: color var(--t) ease, text-shadow var(--t) ease; }
	.foot__tel:hover { text-shadow: 0 0 12px var(--glow); }
	.foot__mail { color: var(--grey); transition: color var(--t) ease; }
	.foot__mail:hover { color: var(--ivory); }
	.foot__sub { font-size: 12px; }
	.foot__grid .ray { font-size: 13px; margin-top: 8px; }
	.foot__grid .ray { align-items: flex-start; } /* two-line document links: keep the line on the first line */
	.foot__grid .ray i { margin-top: .75em; }
	.foot__legal { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--grey-dim); margin: 0; }

	@media (prefers-reduced-motion: reduce) {
		.foot__tel,
		.foot__mail { transition: none; }
	}
</style>

<script>
	// amGoal is defined once, globally, by quiz.js on the pages where the quiz
	// mounts. The legal pages don't load quiz.js, so guard the call instead of
	// assuming it exists — never redefine it here.
	(function () {
		var tel = document.getElementById('footTel');
		if (!tel) return;
		tel.addEventListener('click', function () {
			if (typeof window.amGoal === 'function') { window.amGoal('phone_click'); }
		});
	})();
</script>
