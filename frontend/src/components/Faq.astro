---
// Faq (page block 10) — from content-fallback.json, all 4 entries are the
// client's confirmed answers (НДС, дизайнерский процент, мощность, рекламации).
import content from '../../../content-fallback.json';

interface FaqItem {
	q: string;
	a: string;
	sort: number;
}

const faq = [...(content.faq as FaqItem[])].sort((a, b) => a.sort - b.sort);
---

<section class="sec faq" id="faq">
	<div class="wrap">
		<h2>Вопросы и ответы</h2>
		<dl class="faq__list">
			{faq.map((item) => (
				<div class="faq__item">
					<dt>{item.q}</dt>
					<dd>{item.a}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<style>
	.faq__list { margin: 0; display: grid; }
	.faq__item { border-bottom: 1px solid var(--line-soft); padding: 18px 0; }
	.faq__item:first-child { border-top: 1px solid var(--line-soft); }
	.faq__item dt { font-size: 15.5px; font-weight: 600; color: var(--ivory); margin: 0 0 6px; }
	.faq__item dd { margin: 0; color: var(--grey); font-size: 14px; line-height: 1.55; }
</style>
