---
// Documents (page block 06). Legal entity data from
// "Карточка предприятия АМ (2).docx" — юридический адрес used here (registration
// record), distinct from settings.address (factual/production address in
// content-fallback.json). Договор/сертификат files not received yet — rendered
// as disabled ray-links rather than dead href="#" placeholders.
const legal = {
	name: 'ООО «Авторская мебель»',
	inn: '2373027390',
	kpp: '237301001',
	ogrn: '1252300034843',
	address: '353217, Краснодарский край, Динской район, с/п Южно-Кубанское, пос. Южный, ул. Войсковая, д. 1 Б, пом. 12',
};
---

<section class="sec documents" id="documents">
	<div class="wrap">
		<h2>Документы</h2>
		<ul class="reqs">
			<li><b class="lbl">Юрлицо</b><span>{legal.name}</span></li>
			<li><b class="lbl">ИНН / КПП</b><span>{legal.inn} / {legal.kpp}</span></li>
			<li><b class="lbl">ОГРН</b><span>{legal.ogrn}</span></li>
			<li><b class="lbl">Юр. адрес</b><span>{legal.address}</span></li>
			<li><b class="lbl">НДС</b><span>Работаем без НДС</span></li>
		</ul>
		<div class="doc__links">
			<span class="ray ray--disabled" aria-disabled="true"><i></i>Договор поставки (PDF)</span>
			<span class="ray ray--disabled" aria-disabled="true"><i></i>Сертификат ТР ТС 025/2012</span>
		</div>
		<p class="doc__note">Договор поставки и сертификат готовим к публикации.</p>
	</div>
</section>

<style>
	.reqs { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 12px; }
	.reqs li { display: flex; gap: 16px; align-items: baseline; color: var(--ivory); font-size: 14.5px; line-height: 1.5; }
	.reqs b { flex: 0 0 130px; }
	.doc__links { display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 10px; }
	.ray--disabled { opacity: .4; pointer-events: none; }
	.doc__note { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--grey-dim); margin: 0; }
</style>
