---
// Showcase (page block 03) — since 04.09 a horizontal snap carousel of six
// models instead of the 12-card grid (client feedback 31.08: the page must not
// scroll long; six photos, none repeated from the hero). Hero picks come from
// settings.heroModels, so no photo shown above the fold repeats here (the
// quiz scene is workshop photos since 09.09, not a model). Cards are
// portrait 4:5 because the product shots are portrait.
// 09.09: card titles are the client's model names; the «six of a hundred»
// lead was cut on the client's call — no such range exists, the full range
// goes out with the price list.
//
// Since 08.09 the track loops (user: "по кругу, чтобы не возвращаться
// назад"): the last CLONES cards are repeated before the first real card and
// the first CLONES after the last. The inline script parks the track on the
// first real card before paint; the module script jumps silently by the real
// width whenever a scroll settles inside a clone zone, so "next" from the
// last card lands on a view identical to the first. Clones are aria-hidden
// and out of the tab order. Prices stay in the data shape (Directus, task 9)
// and are not rendered. Photos open in the fullscreen lightbox
// (../scripts/lightbox.js reads the clicked card's own img).
// The inline parking script below is allowed by a hash in astro.config.mjs
// (security.csp): any change to its text needs a new hash there.
import { srcsetFor, type Model, type Settings } from '../lib/content';
import { modelPath } from '../lib/models';

interface Props {
	settings: Settings;
	models: Model[];
}

const { settings, models: allModels } = Astro.props;
const shownAbove = new Set(settings.heroModels);
const models = allModels
	.filter((m) => m.visible && !shownAbove.has(m.sort))
	.sort((a, b) => a.sort - b.sort)
	.slice(0, 6);
const CLONES = models.length > 3 ? 3 : 0;
// Rendered card width per the .model flex-basis rules below.
const CARD_SIZES = '(max-width: 620px) 67vw, (max-width: 860px) 45vw, (max-width: 1080px) 30vw, 312px';
const track = [
	...models.slice(models.length - CLONES).map((m) => ({ m, clone: true })),
	...models.map((m) => ({ m, clone: false })),
	...models.slice(0, CLONES).map((m) => ({ m, clone: true })),
];
---

<section class="sec models" id="models">
	<div class="wrap">
		<div class="models__head">
			<div>
				<h2>Популярные модели</h2>
				<p class="sec__lead">Полный модельный ряд вышлем вместе с прайсом.</p>
			</div>
			<div class="models__nav">
				<button class="arrow" type="button" id="modelsPrev" aria-label="Прокрутить модели назад">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
				</button>
				<button class="arrow" type="button" id="modelsNext" aria-label="Прокрутить модели вперёд">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
				</button>
			</div>
		</div>
		<div class="models__track" id="modelsTrack" data-clones={CLONES} data-real={models.length}>
			{track.map(({ m, clone }) => (
				<div class="model" data-clone={clone ? '' : undefined} aria-hidden={clone ? 'true' : undefined}>
					<button
						class="model__photo"
						type="button"
						data-lightbox-open
						data-model-title={m.title}
						tabindex={clone ? -1 : undefined}
						aria-label={`Открыть фото: ${m.title}`}
					>
						<img
							src={m.photo}
							srcset={srcsetFor(m.photo, m.photoSrcset)}
							sizes={srcsetFor(m.photo, m.photoSrcset) && CARD_SIZES}
							alt={m.title}
							loading="lazy"
							decoding="async"
							width="640"
							height="800"
						/>
					</button>
					<div class="model__body">
						<h3 class="model__title">{m.title}</h3>
						{m.size && <p class="model__size">{m.size}</p>}
						<div class="model__actions">
							<a class="ghost model__request" href="#price" data-model-request={m.title} tabindex={clone ? -1 : undefined}>Уточнить цену</a>
							<a class="model__details" href={modelPath(m)} tabindex={clone ? -1 : undefined} aria-label={`Подробнее: ${m.title}`}>Подробнее</a>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>

	<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр фото" hidden>
		<button class="lightbox__close ghost" type="button" id="lightboxClose">Закрыть</button>
		<img class="lightbox__img" id="lightboxImg" src="" alt="" />
		<a class="cta lightbox__request" id="lightboxRequest" href="#price" data-model-request="" hidden>Уточнить цену</a>
	</div>
</section>

<script is:inline>
	// Park the track on the first real card before first paint so the clones
	// at the head are never seen on load (the module script below does the
	// same again once it runs — this only covers the gap until then). The
	// clone count comes from data-clones rather than define:vars: a static
	// script gets a Content-Security-Policy hash at build time, one with
	// injected variables does not.
	(function () {
		var track = document.getElementById('modelsTrack');
		var card = track && track.querySelector('.model');
		var clones = track ? Number(track.dataset.clones) || 0 : 0;
		if (!card || !clones) return;
		var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
		track.scrollLeft = clones * (card.getBoundingClientRect().width + gap);
	})();
</script>
<script>
	import '../scripts/lightbox.js';

	// lightbox.js opens with the clicked card's currentSrc, which since srcset
	// is a copy sized for the card and looks soft fullscreen. Once the
	// full-size photo (the card img's src) is decoded, swap it in; until then
	// the card copy, already in cache, stays on screen. Runs after
	// lightbox.js's own click handler, which is bound first by the import.
	(function () {
		var overlay = document.getElementById('lightbox');
		var big = document.getElementById('lightboxImg');
		if (!overlay || !big) return;
		document.querySelectorAll('[data-lightbox-open]').forEach(function (btn) {
			btn.addEventListener('click', function () {
				var pic = btn.querySelector('img');
				if (!pic || !pic.srcset || pic.src === big.src) return;
				var shown = big.src;
				var full = new Image();
				full.src = pic.src;
				full.decode().then(function () {
					if (!overlay.hidden && big.src === shown) big.src = full.src;
				}, function () {});
			});
		});
	})();

	// Looping snap track. Arrow buttons scroll by one card; on touch widths
	// the buttons are hidden and the track is swiped natively. Whenever a
	// scroll settles on a clone, the track jumps (no animation) by the real
	// width to the identical real card, so the loop has no visible seam.
	(function () {
		var track = document.getElementById('modelsTrack');
		var prev = document.getElementById('modelsPrev');
		var next = document.getElementById('modelsNext');
		if (!track) return;
		var first = track.querySelector('.model');
		if (!first) return;
		var clones = Number(track.dataset.clones) || 0;
		var real = Number(track.dataset.real) || 0;
		var loops = clones > 0 && real > 0;
		var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		function pitch() {
			var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
			return first.getBoundingClientRect().width + gap;
		}
		function jump(i) {
			track.style.scrollBehavior = 'auto';
			track.scrollLeft = i * pitch();
			track.style.scrollBehavior = '';
		}
		function normalize() {
			if (!loops) return;
			var i = Math.round(track.scrollLeft / pitch());
			if (i < clones) jump(i + real);
			else if (i >= clones + real) jump(i - real);
		}
		function step(dir) {
			normalize();
			track.scrollBy({ left: dir * pitch(), behavior: reduced.matches ? 'auto' : 'smooth' });
		}

		if (loops) {
			jump(clones);
			if ('onscrollend' in window) {
				track.addEventListener('scrollend', normalize);
			} else {
				var timer = null;
				track.addEventListener('scroll', function () {
					if (timer !== null) window.clearTimeout(timer);
					timer = window.setTimeout(normalize, 150);
				}, { passive: true });
			}
			window.addEventListener('resize', normalize);
		}
		if (prev) prev.addEventListener('click', function () { step(-1); });
		if (next) next.addEventListener('click', function () { step(1); });
	})();
</script>

<style>
	.models__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
	.models__head .sec__lead { margin-bottom: 0; }
	.models__nav { display: flex; gap: 6px; flex: 0 0 auto; padding-bottom: 4px; }
	/* up to 1080px the strip runs to the screen edges, wider it stays inside the
	   text column (--edge in tokens.css); padding and scroll-padding keep the first
	   card on the column. It used to stick out by --pad and cut cards mid-way. */
	.models__track {
		display: flex;
		gap: 20px;
		margin: 28px calc(-1 * var(--edge)) 0;
		padding: 0 var(--edge);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-left: var(--edge);
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}
	.models__track::-webkit-scrollbar { display: none; }
	.model { flex: 0 0 calc((100% - 40px) / 3); scroll-snap-align: start; background: var(--panel); border: 1px solid var(--line); }
	.model__photo {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		cursor: pointer;
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: #000;
	}
	.model__photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t) ease; }
	.model__photo:hover img, .model__photo:focus-visible img { transform: scale(1.03); }
	.model__photo:before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(70% 80% at 68% 18%, rgba(122,103,68,.30) 0%, rgba(72,60,40,.13) 45%, transparent 75%),
			linear-gradient(180deg, transparent 55%, rgba(19,18,16,.66) 100%);
	}
	.model__body { padding: 14px 16px 18px; }
	.model__title { font-size: 14.5px; font-weight: 600; color: var(--ivory); margin: 0; line-height: 1.3; }
	.model__size { font-family: var(--mono); font-size: 11px; color: var(--grey-dim); margin: 6px 0 0; }
	.model__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; margin-top: 16px; }
	.model__request { min-height: 44px; padding: 12px 14px; font-size: 11px; text-decoration: none; }
	.model__details { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; text-underline-offset: 3px; }

	@media (max-width: 860px) {
		.model { flex-basis: calc((100% - 20px) / 2); }
	}
	@media (max-width: 620px) {
		.models__nav { display: none; }
		.model { flex-basis: 74%; }
	}

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 18px;
		padding: 76px 24px 24px;
		background: rgba(19,18,16,.96);
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--t) ease;
	}
	.lightbox[hidden] { display: none; } /* UA [hidden] loses to display:flex above */
	.lightbox.on { opacity: 1; pointer-events: auto; }
	.lightbox__img { max-width: 100%; max-height: calc(100vh - 100px); max-height: calc(100svh - 100px); min-height: 0; object-fit: contain; display: block; }
	.lightbox.has-request .lightbox__img { max-height: calc(100vh - 172px); max-height: calc(100svh - 172px); }
	.lightbox__request { flex: 0 0 auto; }
	.lightbox__request[hidden] { display: none; }
	.lightbox__close { position: absolute; top: 20px; right: 20px; }

	@media (prefers-reduced-motion: reduce) {
		.lightbox { transition: none; }
		.model__photo img { transition: none; }
		.model__photo:hover img { transform: none; }
	}
</style>
