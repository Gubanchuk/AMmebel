---
// Showcase grid (page block 03) — imports content-fallback.json directly per
// Ruling R4. Photos are real client-supplied product shots (bright daylight
// interiors) — spec §4 calls for a dark backing + vignette adaptation for this
// exact case ("тёмные подложки, виньетирование"), applied via .model__photo:before.
//
// User change wave 27.08: renamed to "Популярные модели" (this is a subset, not
// the full range), prices intentionally not rendered — priceFrom/priceTo stay in
// the data shape for the Directus schema (task 9) and future use, just not shown
// here — and photos open in a fullscreen lightbox (behavior in
// ../scripts/lightbox.js).
import content from '../../../content-fallback.json';

interface Model {
	title: string;
	size: string;
	priceFrom: number | null;
	priceTo: number | null;
	photo: string;
	visible: boolean;
	sort: number;
}

const models = (content.models as Model[])
	.filter((m) => m.visible)
	.sort((a, b) => a.sort - b.sort);
---

<section class="sec models" id="models">
	<div class="wrap">
		<h2>Популярные модели</h2>
		<p class="sec__lead">Показываем часть ассортимента — полный модельный ряд направим вместе с оптовым предложением после заявки.</p>
		<div class="models__grid">
			{models.map((m, i) => (
				<div class="model">
					<button class="model__photo" type="button" data-lightbox-open data-index={i}>
						<img src={m.photo} alt={m.title} loading="lazy" width="640" height="480" />
					</button>
					<div class="model__body">
						<h3 class="model__title">{m.title}</h3>
						{m.size && <p class="model__size">{m.size}</p>}
					</div>
				</div>
			))}
		</div>
	</div>

	<div class="lightbox" id="lightbox" hidden>
		<button class="lightbox__close ghost" type="button" id="lightboxClose">Закрыть</button>
		<img class="lightbox__img" id="lightboxImg" src="" alt="" />
	</div>
</section>

<script define:vars={{ photos: models.map((m) => ({ src: m.photo, alt: m.title })) }}>
	window.__amModelPhotos = photos;
</script>
<script>
	import '../scripts/lightbox.js';
</script>

<style>
	.models__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
	.model { background: var(--panel); border: 1px solid var(--line); }
	.model__photo {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		cursor: pointer;
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #000;
	}
	.model__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.model__photo:before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(70% 80% at 68% 18%, rgba(122,103,68,.30) 0%, rgba(72,60,40,.13) 45%, transparent 75%),
			linear-gradient(180deg, transparent 45%, rgba(19,18,16,.72) 100%);
	}
	.model__body { padding: 16px 18px 20px; }
	.model__title { font-size: 15px; font-weight: 600; color: var(--ivory); margin: 0 0 6px; line-height: 1.3; }
	.model__size { font-family: var(--mono); font-size: 11px; color: var(--grey-dim); margin: 0; }

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(19,18,16,.96);
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--t) ease;
	}
	.lightbox.on { opacity: 1; pointer-events: auto; }
	.lightbox__img { max-width: 92vw; max-height: 92vh; object-fit: contain; display: block; }
	.lightbox__close { position: absolute; top: 20px; right: 20px; }

	@media (prefers-reduced-motion: reduce) {
		.lightbox { transition: none; }
	}
</style>
