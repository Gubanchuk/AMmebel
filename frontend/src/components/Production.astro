---
// Production (page block 05). Cex photos are not ready yet (client: "по цеху фото
// будут готовы до конца недели") — frames stay as warm-glow placeholders per the
// original plan step; мощность/рекламации now have real client-confirmed values.
const facts = [
	{ label: 'Мощность', value: 'Более 50 изделий в месяц — каждое по индивидуальным размерам клиента' },
	{
		label: 'Рекламации',
		value: 'Рекламаций нет: производство полного цикла под собственным контролем, проверенные поставщики комплектующих, качественный каркас и пены',
	},
];
const frames = ['Раскройный стол', 'Сборка каркаса', 'Обивка крупным планом', 'Склад с упаковкой'];
---

<section class="sec production" id="production">
	<div class="wrap">
		<h2>Производство</h2>
		<p class="sec__lead">Полный цикл под одной крышей в Краснодаре с 2018 года: раскрой, сборка каркаса, обивка и упаковка.</p>
		<div class="frames">
			{frames.map((f) => (
				<div class="frame">
					<span class="lbl">{f}</span>
					<span class="frame__ph">фото на подходе</span>
				</div>
			))}
		</div>
		<ul class="facts">
			{facts.map((f) => (
				<li>
					<b class="lbl">{f.label}</b>
					<span>{f.value}</span>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.frames { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px; background: var(--line-soft); border: 1px solid var(--line-soft); margin: 0 0 30px; }
	.frame { position: relative; background: linear-gradient(160deg, #1B1916, #221E19); aspect-ratio: 4 / 3; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 14px; }
	.frame:before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(70% 80% at 68% 18%, rgba(122,103,68,.22) 0%, rgba(72,60,40,.10) 45%, transparent 75%); }
	.frame .lbl, .frame__ph { position: relative; }
	.frame__ph { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--grey-dim); }
	.facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
	.facts li { display: flex; gap: 16px; align-items: baseline; color: var(--ivory); font-size: 14.5px; line-height: 1.5; }
	.facts b { flex: 0 0 150px; }
</style>
