---
// AM logo — inline SVG. Geometry updated 27.08: user picked the "separate" plate
// variant from clients/sf-sofa/opt-site-mockups/quiz-scene-variants.html section 2
// (feedback on the original ~41%-overlap geometry from .mark: "АМ сливается в
// нижние буквы" — reads as mush at header size). The plate now sits as its own
// line below the "AM" letters with a small gap, no overlap. Letter size, tracking,
// and plate-text size/tracking are unchanged from before — only the plate's y
// position moved down, which required a taller viewBox (114 instead of 90) to
// keep the empty margin above the letters and below the plate roughly
// symmetric. Since the viewBox grew taller at the same width, .logo--sm/--lg
// switched from fixing width (which would have rendered taller than before) to
// fixing height, so the on-screen size in the header is unchanged.
interface Props {
	size?: 'lg' | 'sm';
	inverted?: boolean;
}

const { size = 'lg', inverted = false } = Astro.props;
const classes = ['logo', `logo--${size}`, inverted && 'logo--inverted'].filter(Boolean).join(' ');
---

<svg
	class={classes}
	viewBox="0 0 200 114"
	role="img"
	aria-label="АМ — Авторская мебель"
	xmlns="http://www.w3.org/2000/svg"
>
	<text
		class="logo__am"
		x="100"
		y="62"
		text-anchor="middle"
		font-family="Prata"
		font-size="56"
		letter-spacing="3"
	>АМ</text>
	<rect class="logo__plate-bg" x="18" y="70" width="164" height="21" />
	<text
		class="logo__plate-text"
		x="100"
		y="80.5"
		text-anchor="middle"
		dominant-baseline="central"
		font-family="Onest"
		font-weight="600"
		font-size="9"
		letter-spacing="2.4"
	>АВТОРСКАЯ МЕБЕЛЬ</text>
</svg>

<style>
	.logo {
		display: inline-block;
		line-height: 1;
		color: var(--ivory);
	}
	.logo--lg {
		height: 90px;
		width: auto;
	}
	.logo--sm {
		height: 54px;
		width: auto;
	}
	.logo--inverted {
		color: var(--bg);
	}
	.logo__am {
		fill: currentColor;
	}
	.logo__plate-bg {
		fill: currentColor;
	}
	.logo__plate-text {
		fill: var(--bg);
	}
	.logo--inverted .logo__plate-text {
		fill: var(--ivory);
	}
</style>
